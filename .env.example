# انسخ هذا الملف إلى .env للتشغيل المحلي (لا تُرفع .env إلى Git)
# رابط اتصال PostgreSQL — من Render: Databases → اختر القاعدة → External Database URL
DATABASE_URL=postgres://user:password@host:5432/dbname

# مفتاح توقيع جلسات الدخول — سلسلة عشوائية طويلة
SESSION_SECRET=change-me-to-a-long-random-string

# منفذ الخادم (اختياري، الافتراضي 3000)
# PORT=3000
